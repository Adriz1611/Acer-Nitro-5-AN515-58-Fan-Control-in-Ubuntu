    def _setup_tray(self):
        self.tray = Gtk.StatusIcon.new_from_icon_name("preferences-system")
        self.tray.set_tooltip_text("NitroSense Controller")
        self.tray.set_visible(True)
        self.tray.connect("activate", self._on_tray_activate)
        self.tray.connect("popup-menu", self._on_tray_popup)

    def _on_tray_activate(self, _icon):
        if self.is_visible():
            self.hide()
        else:
            self.show_all()
            self.present()

    def _on_tray_popup(self, icon, button, activate_time):
        menu = Gtk.Menu()

        show_item = Gtk.MenuItem(label="Show / Hide")
        show_item.connect("activate", lambda *_: self._on_tray_activate(icon))
        menu.append(show_item)

        menu.append(Gtk.SeparatorMenuItem())

        quick_profiles = [
            ("Quiet + Auto", "q", "a", None),
            ("Default + Auto", "d", "a", None),
            ("Performance + Max", "p", "m", None),
            ("Default + Custom 50%", "d", "c", 50),
        ]
        for label, power, fan, pct in quick_profiles:
            item = Gtk.MenuItem(label=label)
            item.connect("activate", self._on_tray_profile_activate, power, fan, pct)
            menu.append(item)

        menu.append(Gtk.SeparatorMenuItem())

        quit_item = Gtk.MenuItem(label="Quit")
        quit_item.connect("activate", self._on_tray_quit)
        menu.append(quit_item)

        menu.show_all()
        menu.popup(None, None, Gtk.StatusIcon.position_menu, icon, button, activate_time)

    def _on_tray_profile_activate(self, _item, power, fan, pct):
        if self.running:
            self._set_status("Command already running", ok=False)
            return
        self._set_power_mode(power)
        self._set_fan_mode(fan)
        if pct is not None:
            self.fan_scale.set_value(pct)
        args = [f"{power}{fan}"]
        if fan == "c":
            args.append(str(int(self.fan_scale.get_value())))
        label = f"Tray apply {POWER_MODES[power]['name']} + {FAN_MODES[fan]['name']}"
        self._run_backend(args, label)

    def _on_tray_quit(self, _item):
        self.quitting = True
        if self.tray is not None:
            self.tray.set_visible(False)
        app = self.get_application()
        if app is not None:
            app.quit()

    def _on_delete_event(self, _widget, _event):
        if self.quitting:
            return False
        self.hide()
        self._set_status("Window hidden to tray", ok=True)
        return True

    def _auth_mode_label(self):
        if self.auth_mode == "sudo-n":
            return "Passwordless sudo"
        if self.auth_mode == "pkexec":
            return "pkexec prompt"
        return "root"

    def _append_output(self, text):
        end = self.output_buffer.get_end_iter()
        self.output_buffer.insert(end, text)
        mark = self.output_buffer.create_mark(None, self.output_buffer.get_end_iter(), False)
        self.output_view.scroll_to_mark(mark, 0.0, True, 0.0, 1.0)

    def _set_status(self, text, ok=True):
        self.status_label.set_text(text)
        ctx = self.status_label.get_style_context()
        if ok:
            ctx.add_class("status-ok")
            ctx.remove_class("status-bad")
        else:
            ctx.add_class("status-bad")
            ctx.remove_class("status-ok")

    def _check_prereqs(self):
        if not os.path.isfile(self.script_path):
            self._set_status(f"Missing backend script: {self.script_path}", ok=False)
            self._set_controls_sensitive(False)
            return
        if not os.access(self.script_path, os.X_OK):
            self._set_status(f"Backend script is not executable: {self.script_path}", ok=False)
            self._set_controls_sensitive(False)
            return
        if self.auth_mode == "pkexec" and shutil.which("pkexec") is None and os.geteuid() != 0:
            self._set_status("pkexec not found. Install policykit-1 or run as root.", ok=False)
            self._set_controls_sensitive(False)
            return

        if self.auth_mode == "sudo-n":
            self._set_status("Ready (passwordless sudo mode enabled)", ok=True)
        elif self.auth_mode == "root":
            self._set_status("Ready (running as root)", ok=True)
        else:
            self._set_status("Ready (pkexec authentication mode)", ok=True)

    def _detect_auth_mode(self):
        if os.geteuid() == 0:
            return "root"
        if self._has_passwordless_sudo():
            return "sudo-n"
        return "pkexec"

    def _has_passwordless_sudo(self):
        if shutil.which("sudo") is None:
            return False
        try:
            result = subprocess.run(
                ["sudo", "-n", "/bin/bash", self.script_path, "--help"],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                check=False,
            )
            return result.returncode == 0
        except Exception:
            return False

    def _set_running(self, running):
        self.running = running
        if running:
            self.spinner.show()
            self.spinner.start()
        else:
            self.spinner.stop()
            self.spinner.hide()
        self._set_controls_sensitive(not running)

    def _set_controls_sensitive(self, enabled):
        self.apply_btn.set_sensitive(enabled)
        self.nvidia_btn.set_sensitive(enabled)
        self.energy_btn.set_sensitive(enabled)
        self.ec_btn.set_sensitive(enabled)
        for btn in self.power_buttons.values():
            btn.set_sensitive(enabled)
        for btn in self.fan_buttons.values():
            btn.set_sensitive(enabled)
        self.fan_scale.set_sensitive(enabled and self.selected_fan == "c")

    def _set_power_mode(self, key):
        self.selected_power = key
        for mode, btn in self.power_buttons.items():
            ctx = btn.get_style_context()
            if mode == key:
                ctx.add_class("power-active")
            else:
                ctx.remove_class("power-active")
        self._update_ui_state()

    def _set_fan_mode(self, key):
        self.selected_fan = key
        for mode, btn in self.fan_buttons.items():
            ctx = btn.get_style_context()
            if mode == key:
                ctx.add_class("fan-active")
            else:
                ctx.remove_class("fan-active")
        self._update_ui_state()

    def _on_power_clicked(self, btn):
        self._set_power_mode(btn.mode_key)

    def _on_fan_clicked(self, btn):
        self._set_fan_mode(btn.mode_key)

    def _on_scale_changed(self, _scale):
        self._update_ui_state()

    def _build_command(self, args):
        if self.auth_mode == "root":
            return [self.script_path, *args]
        if self.auth_mode == "sudo-n":
            return ["sudo", "-n", "/bin/bash", self.script_path, *args]
        safe_path = "/usr/sbin:/usr/bin:/sbin:/bin"
        home = os.environ.get("HOME", str(Path.home()))
        return [
            "pkexec",
            "/usr/bin/env",
            f"PATH={safe_path}",
            f"HOME={home}",
            "/bin/bash",
            self.script_path,
            *args,
        ]

    def _update_ui_state(self):
        pct = int(self.fan_scale.get_value())
        self.fan_pct_label.set_text(f"{pct}%")

        args = [f"{self.selected_power}{self.selected_fan}"]
        if self.selected_fan == "c":
            args.append(str(pct))

        profile_text = (
            f"Power: {POWER_MODES[self.selected_power]['name']}  |  "
            f"Fan: {FAN_MODES[self.selected_fan]['name']}"
        )
        if self.selected_fan == "c":
            profile_text += f" ({pct}%)"

        self.selection_label.set_text(profile_text)
        self.fan_scale.set_sensitive(not self.running and self.selected_fan == "c")

        if self.profile_loaded:
            self._save_profile(self.selected_power, self.selected_fan, pct)

    def _run_backend(self, args, label):
        if self.running:
            self._set_status("A command is already running", ok=False)
            return

        cmd = self._build_command(args)
        self.last_command = shlex.join(cmd)
        self._append_output(f"\n[{self._now()}] $ {self.last_command}\n")
        self._set_status(f"Running: {label}")
        self._set_running(True)

        def worker():
            try:
                proc = subprocess.Popen(
                    cmd,
                    stdout=subprocess.PIPE,
                    stderr=subprocess.STDOUT,
                    text=True,
                    bufsize=1,
                )
                assert proc.stdout is not None
                for line in proc.stdout:
                    GLib.idle_add(self._append_output, line)

                rc = proc.wait()
                if rc != 0 and self.auth_mode == "sudo-n":
                    GLib.idle_add(self._append_output, f"[{self._now()}] sudo -n failed, retrying with pkexec...\n")
                    retry_rc = self._run_with_pkexec(args)
                    if retry_rc == 0:
                        GLib.idle_add(self._set_status, f"Done: {label} (pkexec fallback)", True)
                        return
                    rc = retry_rc

                if rc == 0:
                    GLib.idle_add(self._set_status, f"Done: {label}", True)
                else:
                    GLib.idle_add(self._set_status, f"Failed ({rc}): {label}", False)
            except Exception as exc:
                GLib.idle_add(self._append_output, f"Error: {exc}\n")
                GLib.idle_add(self._set_status, f"Error: {label}", False)
            finally:
                GLib.idle_add(self._set_running, False)

        threading.Thread(target=worker, daemon=True).start()

    def _run_with_pkexec(self, args):
        safe_path = "/usr/sbin:/usr/bin:/sbin:/bin"
        home = os.environ.get("HOME", str(Path.home()))
        cmd = [
            "pkexec",
            "/usr/bin/env",
            f"PATH={safe_path}",
            f"HOME={home}",
            "/bin/bash",
            self.script_path,
            *args,
        ]
        self.last_command = shlex.join(cmd)
        GLib.idle_add(self._append_output, f"[{self._now()}] $ {self.last_command}\n")
        proc = subprocess.Popen(
            cmd,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            text=True,
            bufsize=1,
        )
        assert proc.stdout is not None
        for line in proc.stdout:
            GLib.idle_add(self._append_output, line)
        self.auth_mode = "pkexec"
        GLib.idle_add(self.auth_label.set_text, f"Auth: {self._auth_mode_label()}")
        return proc.wait()

    def _now(self):
        return datetime.now().strftime("%H:%M:%S")

    def _confirm_high_profile(self):
        pct = int(self.fan_scale.get_value())
        aggressive = self.selected_power == "p" or self.selected_fan == "m" or (
            self.selected_fan == "c" and pct >= 80
        )
        if not aggressive:
            return True

        dialog = Gtk.MessageDialog(
            transient_for=self,
            modal=True,
            message_type=Gtk.MessageType.WARNING,
            buttons=Gtk.ButtonsType.OK_CANCEL,
            text="Apply high-performance profile?",
        )
        dialog.format_secondary_text(
            "This can increase fan noise, heat output, and power draw."
        )
        response = dialog.run()
        dialog.destroy()
        return response == Gtk.ResponseType.OK

    def _on_apply_clicked(self, _btn):
        if not self._confirm_high_profile():
            self._set_status("Cancelled profile apply", ok=False)
            return

        pct = int(self.fan_scale.get_value())
        args = [f"{self.selected_power}{self.selected_fan}"]
        label = f"Apply {POWER_MODES[self.selected_power]['name']} + {FAN_MODES[self.selected_fan]['name']}"
        if self.selected_fan == "c":
            args.append(str(pct))
            label += f" ({pct}%)"

        self._run_backend(args, label)

    def _on_nvidia_clicked(self, _btn):
        self._run_backend(["n"], "Restart NVIDIA PowerD")

    def _on_energy_clicked(self, _btn):
        self._run_backend(["e"], "Read energy data")

    def _on_dump_ec_clicked(self, _btn):
        self._run_backend(["r"], "Dump EC registers")

    def _on_clear_log_clicked(self, _btn):
        self.output_buffer.set_text("")
        self._append_output(f"[{self._now()}] Output cleared.\n")

    def _on_copy_command_clicked(self, _btn):
        if not self.last_command:
            self._set_status("No command to copy yet", ok=False)
            return
        clipboard = Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD)
        clipboard.set_text(self.last_command, -1)
        self._set_status("Last command copied to clipboard", ok=True)

    def _load_profile(self):
        power = "d"
        fan = "a"
        pct = 50

        try:
            if CONFIG_FILE.is_file():
                data = json.loads(CONFIG_FILE.read_text(encoding="utf-8"))
                power = data.get("power", power)
                fan = data.get("fan", fan)
                pct = int(data.get("fan_pct", pct))
        except Exception:
            pass

        if power not in POWER_MODES:
            power = "d"
        if fan not in FAN_MODES:
            fan = "a"
        pct = max(0, min(100, pct))

        self._set_power_mode(power)
        self._set_fan_mode(fan)
        self.fan_scale.set_value(pct)
        self.profile_loaded = True

    def _save_profile(self, power, fan, pct):
        try:
            CONFIG_DIR.mkdir(parents=True, exist_ok=True)
            CONFIG_FILE.write_text(
                json.dumps({"power": power, "fan": fan, "fan_pct": pct}, indent=2),
                encoding="utf-8",
            )
        except Exception:
            pass


class NitroSenseApp(Gtk.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID)

    def do_activate(self):
        win = NitroSenseWindow(self)
        win.show_all()
        win.present()


def main():
    app = NitroSenseApp()
    app.run(None)


if __name__ == "__main__":
    main()
