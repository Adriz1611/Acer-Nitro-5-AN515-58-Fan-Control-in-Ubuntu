    def _resolve_backend_script(self):
        env_path = os.environ.get("NITROSENSE_BACKEND", "").strip()
        candidates = []
        if env_path:
            candidates.append(Path(env_path).expanduser())
        candidates.extend(
            [
                Path(__file__).resolve().parent / "nitrosense",
                Path("/usr/lib/nitrosense/nitrosense"),
            ]
        )

        for candidate in candidates:
            if candidate.is_file():
                return str(candidate.resolve())
        return str((Path(__file__).resolve().parent / "nitrosense").resolve())

